# Copy to .env. See the Configuration section of the README for where this file
# is searched for and how to add more servers.

IBMI_HOST=ibmi.example.com
IBMI_USER=MYUSER
IBMI_PASSWORD=changeme

# optional
IBMI_5250_DEVICE=              # workstation id, else the host picks QPADEVxxxx
IBMI_5250_PORT=23              # 992 is telnet over tls, 23 is plain
IBMI_5250_CCSID=37             # ebcdic page: 273 german, 500 international, 1140 us with the euro
IBMI_5250_TERMINAL=IBM-3477-FC # IBM-3179-2 for a box that refuses this one, at 24x80
IBMI_5250_TLS_INSECURE=false   # accept any certificate on 992, self signed included
IBMI_5250_VIEWER=false         # true starts the live view, non interactive, on 127.0.0.1
IBMI_5250_VIEWER_PORT=5250     # falls back to a free port when this one is busy
IBMI_5250_TRACE=false          # true adds what the host sent for each key to the snapshot and history
IBMI_5250_CURLIB=              # typed into current library at sign on
IBMI_5250_PROGRAM=             # typed into program/procedure at sign on
IBMI_5250_MENU=                # typed into menu at sign on

# restricted mode
# Ten job scoped commands are on it: 
# call, strdbg, enddbg, chgcurlib, addlible, rmvlible, chglibl, dsplibl, edtlibl and signoff. 
# Everything else is refused.
IBMI_RESTRICTED=true           
IBMI_ALLOWED_CL=               # more verbs to allow, such as your own start command

# with restricted mode off, nothing is refused unless it is named here.
IBMI_BLOCKED_CL=               # verbs to refuse, comma or space separated
